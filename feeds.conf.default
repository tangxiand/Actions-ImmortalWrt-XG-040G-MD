# PonWrt 官方 feeds（含 PON 两个私有源，必须保留）
src-git packages https://github.com/immortalwrt/packages.git
src-git luci https://github.com/immortalwrt/luci.git
src-git routing https://github.com/openwrt/routing.git
src-git telephony https://github.com/openwrt/telephony.git
src-git video https://github.com/openwrt/video.git
src-git pon_drivers https://github.com/pbs05/openwrt-pon-drivers.git
src-git pon_userspace https://github.com/pbs05/openwrt-pon-userspace.git
# iStore 应用商店（集成到 LuCI）
# 注意：本工作流已按用户要求移除 iStore（依赖链长、易静默丢弃整包）
src-git istore https://github.com/istoreos/istore.git;main
# socat 的 LuCI 界面（官方 feeds 没有此包）改由 diy-part1.sh 直接克隆进 package/，
# 不再用 src-git 第三方源——上一轮 CI 里该源未被 feeds 索引到（日志 "feeds 里找不到 luci-app-socat"）。
# 如需回退到 feeds 方式，取消下面注释并删掉 diy-part1.sh 里的 socat 处理段：
