# ===== 目标设备：只出 Nokia XG-040G-MD (UBI) 一台 =====
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_nokia_xg-040g-md-ubi=y

# ===== PON 核心件（设备 profile 已自带，这里显式钉住防漏）=====
CONFIG_PACKAGE_kmod-airoha-pon-frontend=y
CONFIG_PACKAGE_kmod-airoha-en7572=y
CONFIG_PACKAGE_kmod-airoha-xpon=y
CONFIG_PACKAGE_airoha-ponctl=y
CONFIG_PACKAGE_airoha-pond=y
CONFIG_PACKAGE_fitblk=y
CONFIG_PACKAGE_nand-utils=y
CONFIG_PACKAGE_ubi-utils=y
# PON 的 LuCI 界面（网络 → PON）
CONFIG_PACKAGE_luci-app-pon=y
CONFIG_PACKAGE_luci-i18n-pon-zh-cn=y
# OMCI/OAM 抓包调试工具，可不要
CONFIG_PACKAGE_airoha-pon-debug=y

# ===== 证书生成：px5g-mbedtls =====
# px5g-mbedtls / px5g-wolfssl / px5g-openssl 都 PROVIDES:=px5g，且都要装 /usr/sbin/px5g，
# 同时选会文件冲突，只能留一个。基线里没选任何 px5g，这里显式钉 mbedtls 实现。
CONFIG_PACKAGE_px5g-mbedtls=y
# CONFIG_PACKAGE_px5g-wolfssl is not set
# CONFIG_PACKAGE_px5g-openssl is not set

# ===== 包管理器：此树用 apk =====
CONFIG_USE_APK=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_openwrt-keyring=y

# ===== 基础系统 =====
CONFIG_DEVEL=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_DEVMEM=y
CONFIG_KERNEL_DEVMEM=y
CONFIG_LUCI_LANG_zh_Hans=y

# ===== IPTV / VLAN / 组播 =====
CONFIG_PACKAGE_kmod-8021q=y
CONFIG_PACKAGE_vlan-utils=y
CONFIG_BRIDGE_IGMP_SNOOPING=y
CONFIG_PACKAGE_igmpproxy=y
CONFIG_PACKAGE_udpxy=y
CONFIG_PACKAGE_luci-app-iptv=y

# ===== 基础工具与网络组件 =====
CONFIG_PACKAGE_autocore=y
CONFIG_PACKAGE_cgi-io=y
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_i2c-tools=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-netlink-diag=y
CONFIG_PACKAGE_kmod-nf-socket=y
CONFIG_PACKAGE_kmod-nf-tproxy=y
CONFIG_PACKAGE_kmod-nft-bridge=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_libpcap=y
CONFIG_PACKAGE_libpcre2=y
CONFIG_PCRE2_JIT_ENABLED=y

# ===== LuCI 主题 =====
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-light=y

# ===== 系统工具 =====
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-rpcsys=y
CONFIG_PACKAGE_rpcd-mod-ucode=y
CONFIG_PACKAGE_ucode-mod-html=y
CONFIG_PACKAGE_ucode-mod-log=y
CONFIG_PACKAGE_ucode-mod-math=y

# ===== ZeroTier =====
CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn=y

# ===== 网络唤醒 =====
CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_wakeonlan=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y

# ===== DDNS：按 2026-11-10 要求「动态域名解析 + ddns-go」全部移除 =====
# 关键：构建是「官方基线 configs/an7581.config + my.config 差异项叠加」，
# 单纯删掉 =y 行不够——基线里若带同名符号仍然生效。
# build.yml 会识别 "# CONFIG_XXX is not set" 并用它替换基线里的同名 =y 行，
# 所以这里必须写成显式的「is not set」才是真取消。
# 动态域名解析（ddns-scripts + luci-app-ddns）
# CONFIG_PACKAGE_ddns-scripts is not set
# CONFIG_PACKAGE_ddns-scripts-services is not set
# CONFIG_PACKAGE_ddns-scripts-cloudflare is not set
# CONFIG_PACKAGE_ddns-scripts-aliyun is not set
# CONFIG_PACKAGE_luci-app-ddns is not set
# CONFIG_PACKAGE_luci-i18n-ddns-zh-cn is not set
# DDNS-Go（Go 版）
# CONFIG_PACKAGE_ddns-go is not set
# CONFIG_PACKAGE_luci-app-ddns-go is not set
# CONFIG_PACKAGE_luci-i18n-ddns-go-zh-cn is not set

# ===== socat：命令行 + 第三方 LuCI 界面（服务 → Socat）=====
CONFIG_PACKAGE_socat=y
CONFIG_PACKAGE_luci-app-socat=y
CONFIG_PACKAGE_luci-i18n-socat-zh-cn=y

# ===== PPPoE / IPv6 / 防火墙 =====
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_IPV6=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y

# ===== SSH =====
CONFIG_PACKAGE_dropbear=y
CONFIG_DROPBEAR_SMALL_CODE=y
CONFIG_DROPBEAR_ED25519=y
CONFIG_DROPBEAR_CURVE25519=y

# ===== USB 存储 =====
CONFIG_PACKAGE_kmod-usb-common=y
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_e2fsprogs=y

# ===== socat 图形界面的运行前提（保留）=====
# socat 的 LuCI 界面是第三方 Lua 应用（chenmozhijin/luci-app-socat，依赖 +socat +luci +luci-compat）
# 在 ucode/JS 为主的 LuCI 上跑 Lua 控制器，必须有这三件
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_uhttpd-mod-lua=y
# 文件浏览器（istore 源，轻量文件管理，上一版已验证可用）
CONFIG_PACKAGE_luci-app-filebrowser=y

# ===== OpenVPN：服务端（保留）+ 客户端（2026-11-10 新增）=====
# 服务端：immortalwrt/luci master 的包名是 luci-app-openvpn-server（服务 → OpenVPN Server）
# 用 openssl 实现，与固件里 libopenssl 复用同一套库，省体积
CONFIG_PACKAGE_openvpn-openssl=y
CONFIG_PACKAGE_openvpn-easy-rsa=y
CONFIG_PACKAGE_luci-app-openvpn-server=y
CONFIG_PACKAGE_luci-i18n-openvpn-server-zh-cn=y
# 客户端：immortalwrt/luci master 与 openwrt/luci master 都已移除 luci-app-openvpn，
#   但 openwrt/luci 的 openwrt-24.10 稳定分支仍保留该包
#   （LUCI_TITLE:=LuCI Support for OpenVPN；LUCI_DEPENDS:=+luci-base +luci-compat；
#    po/zh_Hans/openvpn.po 齐全 → 可生成 luci-i18n-openvpn-zh-cn）。
#   diy-part1.sh 从该分支单独取 applications/luci-app-openvpn 放进 package/，
#   并把 Makefile 的 include ../../luci.mk 改成 include $(TOPDIR)/feeds/luci/luci.mk。
#   菜单「VPN → OpenVPN」，可编辑 sample_client / 上传 .ovpn 建客户端实例并启停。
#   它只安装 /etc/config/openvpn_recipes + LuCI Lua 文件，与 server 包的
#   /etc/config/openvpn 不冲突；Lua 运行前提（luci-compat/luci-lua-runtime/uhttpd-mod-lua）本配置已含。
CONFIG_PACKAGE_luci-app-openvpn=y
CONFIG_PACKAGE_luci-i18n-openvpn-zh-cn=y

# ===== 在线安装能力（apk 源，无需重新编译即可装用户态包）=====
# distfeeds.list 由构建时 VERSION_REPO 生成，PonWrt 默认指向 downloads.immortalwrt.org/snapshots
# 走 https 必须有 CA 根证书，否则 apk update 直接报证书错误
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y

# ===== apk 软件源：编译期就把 4 条 404 源注释掉（2026-11-10，确保软件源可用）=====
# 依据 immortalwrt/immortalwrt 的 scripts/feeds（feed_config()）：
#   config FEED_<name> / tristate "Enable feed <name>" / "Say M to add the feed commented out."
# 以及 include/feeds.mk 的 FeedSourcesAppendAPK：
#   CONFIG_FEED_<feed>=m 时生成的行以 "# " 开头，即写进 distfeeds.list 但被注释。
# 官方下载站只托管 base/luci/packages/routing/telephony（+targets），
# 而 pon_drivers / pon_userspace（PonWrt 私有）、istore、video 在服务器上没有目录，
# 若生成未注释的 packages.adb 就会 404 → apk update 返回 4 → LuCI 报 JSON 错误。
# =m 只影响「是否写进 distfeeds.list」，不影响该 feed 的包被选中/编译
# （scripts/feeds install -a 按 feeds.conf 全量安装，与 CONFIG_FEED_* 无关）。
# CONFIG_PER_FEED_REPO=y 是 CONFIG_FEED_* 符号的 depends 前提，显式钉死防漏。
# 另有 diy-part2.sh 的 98-fix-apk-repos 作双保险（首启幂等清理，兼容 sysupgrade 保留旧配置）。
CONFIG_PER_FEED_REPO=y
CONFIG_FEED_packages=y
CONFIG_FEED_luci=y
CONFIG_FEED_routing=y
CONFIG_FEED_telephony=y
CONFIG_FEED_pon_drivers=m
CONFIG_FEED_pon_userspace=m
CONFIG_FEED_istore=m
CONFIG_FEED_video=m

# ===== NPU / 硬件流卸载（AN7581 的 PPE+NPU 硬件快转）=====
# 1) NPU 固件（驱动加载微码用；an7581 目标虽默认含，这里显式钉死防漏）
CONFIG_PACKAGE_airoha-en7581-npu-firmware=y
# 2) nftables 流卸载内核模块（firewall4 的 flow_offloading_hw 走它）
CONFIG_PACKAGE_kmod-nft-offload=y
# 注：上游 immortalwrt/luci 没有 luci-app-airoha-npu 监控页，但社区仓库 luanmuc/luci-app-airoha-npu
#    （v1.2.1，与官方固件同源）提供它，由 diy-part1.sh 克隆进 package/，故此处显式钉入（见下方 NPU 状态页段）。
#    首次启动后由 diy-part2.sh 写入的 uci-defaults 自动打开 flow_offloading_hw。

# ===== HTTPS DNS 代理（DoH，DNS 加密防劫持）=====
# 默认用 Google/Cloudflare 的 DoH，并自动接管 dnsmasq 上游；依赖的 ca-bundle 已在本文件上方。
CONFIG_PACKAGE_https-dns-proxy=y
CONFIG_PACKAGE_luci-app-https-dns-proxy=y

# ===== NPU 状态页（社区包 luanmuc/luci-app-airoha-npu v1.2.1，与官方固件同源）=====
# 只做监控/CPU 频率/PPE 流表展示，不负责开启硬件加速（加速由上面的 NPU 固件 +
# diy-part2.sh 的 flow_offloading_hw 负责）。该包由 diy-part1.sh 克隆进 package/。
# 其 Frame Engine / 超频部分依赖 devmem：本文件上方已设 CONFIG_BUSYBOX_CONFIG_DEVMEM / CONFIG_KERNEL_DEVMEM。
CONFIG_PACKAGE_luci-app-airoha-npu=y
CONFIG_PACKAGE_luci-i18n-airoha-npu-zh-cn=y

# ===== 温度传感（LuCI 概览页 CPU / PON 温度）=====
# 概览页「温度」行【不是】内核热区自动渲染。真实调用链：
#   luci-mod-status/.../10_system.js -> rpc luci.getTempInfo
#   -> luci-base/root/usr/share/rpcd/ucode/luci 的 popen('/sbin/tempinfo')
#   -> 其 stdout 原样作为「温度」行显示。
# 所以 CPU + PON 两个温度由 diy-part2.sh 注入的 /sbin/tempinfo 拼装：
#   CPU: /sys/class/thermal/thermal_zone*/temp（毫摄氏度）
#   PON: /usr/sbin/ponctl ... status --json -> frontend.temperature_celsius
#        即光模块 DDM 温度，与「网络 → PON → 状态」的「光前端温度」同一字段；
#        【不是】内核 thermal zone，也不依赖设备树注册 PON 热区。
# CONFIG_THERMAL / CONFIG_AIROHA_THERMAL 为显式声明（若基线内核已内置则为冗余保护，不影响结果）；
# 真正必需的是 jsonfilter（tempinfo 解析 ponctl JSON），已在 build.yml 配置阶段硬断言。
CONFIG_THERMAL=y
CONFIG_AIROHA_THERMAL=y
CONFIG_PACKAGE_jsonfilter=y

# ===== iStore 应用商店（菜单「服务 → iStore」，包名 luci-app-store）=====
# 用户 2026-11-07 要求重新集成；PKG_VERSION=0.2.1-r1，与现有固件一致。
# 来自 feeds.conf.default 里的 istore 源（istoreos/istore;main）。
# 只需选 luci-app-store，其 LUCI_DEPENDS 自动拉 curl/tar/libuci-lua/mount-utils/luci-lib-taskd；
# luci-lib-taskd 再拉 luci-lib-xterm + taskd（后端守护进程）。luci-compat 本配置已含。
# 注意：编译时会从 github 下载 istore-ui 前端 tarball（linkease/istore-ui），需联网 download。
CONFIG_PACKAGE_luci-app-store=y
