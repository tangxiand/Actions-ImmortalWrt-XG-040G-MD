# ===== 目标设备：只出 Nokia XG-040G-MD (UBI) 一台 =====
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_nokia_xg-040g-md-ubi=y

# ===== PON 核心件（设备 profile 已自带，这里显式钉住防漏）=====
CONFIG_PACKAGE_kmod-airoha-pon-frontend=y
CONFIG_PACKAGE_kmod-airoha-en7572=y
CONFIG_PACKAGE_kmod-airoha-xpon=y
CONFIG_PACKAGE_airoha-ponctl=y
CONFIG_PACKAGE_airoha-pond=y
CONFIG_PACKAGE_fitblk=y
CONFIG_PACKAGE_nand-utils=y
CONFIG_PACKAGE_ubi-utils=y
# PON 的 LuCI 界面（网络 → PON）
CONFIG_PACKAGE_luci-app-pon=y
CONFIG_PACKAGE_luci-i18n-pon-zh-cn=y
# OMCI/OAM 抓包调试工具，可不要
CONFIG_PACKAGE_airoha-pon-debug=y

# ===== 证书生成：px5g-mbedtls =====
# px5g-mbedtls / px5g-wolfssl / px5g-openssl 都 PROVIDES:=px5g，且都要装 /usr/sbin/px5g，
# 同时选会文件冲突，只能留一个。基线里没选任何 px5g，这里显式钉 mbedtls 实现。
CONFIG_PACKAGE_px5g-mbedtls=y
# CONFIG_PACKAGE_px5g-wolfssl is not set
# CONFIG_PACKAGE_px5g-openssl is not set

# ===== 包管理器：此树用 apk =====
CONFIG_USE_APK=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_openwrt-keyring=y

# ===== 基础系统 =====
CONFIG_DEVEL=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_DEVMEM=y
CONFIG_KERNEL_DEVMEM=y
CONFIG_LUCI_LANG_zh_Hans=y

# ===== IPTV / VLAN / 组播 =====
CONFIG_PACKAGE_kmod-8021q=y
CONFIG_PACKAGE_vlan-utils=y
CONFIG_BRIDGE_IGMP_SNOOPING=y
CONFIG_PACKAGE_igmpproxy=y
CONFIG_PACKAGE_udpxy=y
CONFIG_PACKAGE_luci-app-iptv=y

# ===== 基础工具与网络组件 =====
CONFIG_PACKAGE_autocore=y
CONFIG_PACKAGE_cgi-io=y
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_i2c-tools=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-netlink-diag=y
CONFIG_PACKAGE_kmod-nf-socket=y
CONFIG_PACKAGE_kmod-nf-tproxy=y
CONFIG_PACKAGE_kmod-nft-bridge=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_libpcap=y
CONFIG_PACKAGE_libpcre2=y
CONFIG_PCRE2_JIT_ENABLED=y

# ===== LuCI 主题 =====
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-light=y

# ===== 系统工具 =====
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-rpcsys=y
CONFIG_PACKAGE_rpcd-mod-ucode=y
CONFIG_PACKAGE_ucode-mod-html=y
CONFIG_PACKAGE_ucode-mod-log=y
CONFIG_PACKAGE_ucode-mod-math=y

# ===== ZeroTier =====
CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn=y

# ===== 网络唤醒 =====
CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_wakeonlan=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y

# ===== DDNS：两套都装 =====
# 1) DDNS-Go（Go 版，界面独立）
CONFIG_PACKAGE_ddns-go=y
CONFIG_PACKAGE_luci-app-ddns-go=y
CONFIG_PACKAGE_luci-i18n-ddns-go-zh-cn=y
# 2) 经典「动态 DNS」（ddns-scripts + luci-app-ddns，服务菜单里的“动态 DNS”）
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-services=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_ddns-scripts-aliyun=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y

# ===== socat：命令行 + 第三方 LuCI 界面（服务 → Socat）=====
CONFIG_PACKAGE_socat=y
CONFIG_PACKAGE_luci-app-socat=y
CONFIG_PACKAGE_luci-i18n-socat-zh-cn=y

# ===== PPPoE / IPv6 / 防火墙 =====
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_IPV6=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y

# ===== SSH =====
CONFIG_PACKAGE_dropbear=y
CONFIG_DROPBEAR_SMALL_CODE=y
CONFIG_DROPBEAR_ED25519=y
CONFIG_DROPBEAR_CURVE25519=y

# ===== USB 存储 =====
CONFIG_PACKAGE_kmod-usb-common=y
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_e2fsprogs=y

# ===== socat 图形界面的运行前提（保留）=====
# socat 的 LuCI 界面是第三方 Lua 应用（chenmozhijin/luci-app-socat，依赖 +socat +luci +luci-compat）
# 在 ucode/JS 为主的 LuCI 上跑 Lua 控制器，必须有这三件
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_uhttpd-mod-lua=y
# 文件浏览器（istore 源，轻量文件管理，上一版已验证可用）
CONFIG_PACKAGE_luci-app-filebrowser=y

# ===== OpenVPN =====
# 重要：immortalwrt/luci 里没有 luci-app-openvpn，真实包名是 luci-app-openvpn-server
# 用 openssl 实现，与固件里 libopenssl 复用同一套库，省体积
# 其 LUCI_DEPENDS 已带 openvpn-easy-rsa / kmod-tun，这里把 openvpn-easy-rsa 显式钉一下更稳
CONFIG_PACKAGE_openvpn-openssl=y
CONFIG_PACKAGE_openvpn-easy-rsa=y
CONFIG_PACKAGE_luci-app-openvpn-server=y
CONFIG_PACKAGE_luci-i18n-openvpn-server-zh-cn=y

# ===== 在线安装能力（apk 源，无需重新编译即可装用户态包）=====
# distfeeds.list 由构建时 VERSION_REPO 生成，PonWrt 默认指向 downloads.immortalwrt.org/snapshots
# 走 https 必须有 CA 根证书，否则 apk update 直接报证书错误
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y

# ===== NPU / 硬件流卸载（AN7581 的 PPE+NPU 硬件快转）=====
# 1) NPU 固件（驱动加载微码用；an7581 目标虽默认含，这里显式钉死防漏）
CONFIG_PACKAGE_airoha-en7581-npu-firmware=y
# 2) nftables 流卸载内核模块（firewall4 的 flow_offloading_hw 走它）
CONFIG_PACKAGE_kmod-nft-offload=y
# 注：上游 immortalwrt/luci 没有 luci-app-airoha-npu 监控页，但社区仓库 luanmuc/luci-app-airoha-npu
#    （v1.2.1，与官方固件同源）提供它，由 diy-part1.sh 克隆进 package/，故此处显式钉入（见下方 NPU 状态页段）。
#    首次启动后由 diy-part2.sh 写入的 uci-defaults 自动打开 flow_offloading_hw。

# ===== HTTPS DNS 代理（DoH，DNS 加密防劫持）=====
# 默认用 Google/Cloudflare 的 DoH，并自动接管 dnsmasq 上游；依赖的 ca-bundle 已在本文件上方。
CONFIG_PACKAGE_https-dns-proxy=y
CONFIG_PACKAGE_luci-app-https-dns-proxy=y

# ===== NPU 状态页（社区包 luanmuc/luci-app-airoha-npu v1.2.1，与官方固件同源）=====
# 只做监控/CPU 频率/PPE 流表展示，不负责开启硬件加速（加速由上面的 NPU 固件 +
# diy-part2.sh 的 flow_offloading_hw 负责）。该包由 diy-part1.sh 克隆进 package/。
# 其 Frame Engine / 超频部分依赖 devmem：本文件上方已设 CONFIG_BUSYBOX_CONFIG_DEVMEM / CONFIG_KERNEL_DEVMEM。
CONFIG_PACKAGE_luci-app-airoha-npu=y
CONFIG_PACKAGE_luci-i18n-airoha-npu-zh-cn=y
