#!/bin/sh /etc/rc.common
# pon-watchdog —— procd 守护进程（单实例、崩溃自动拉起）
# 由 diy-part2.sh 复制进 openwrt/files/etc/init.d/，首启由
# files/etc/uci-defaults/96-pon-watchdog 执行 enable + start。

START=95
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/pon-watchdog --loop
	# threshold=3600s, timeout=5s, retry=0（无限重拉）
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "pon-watchdog"
}

reload_service() {
	restart
}
